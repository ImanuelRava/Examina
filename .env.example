# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required in production).
# Free options: Neon (recommended for Vercel), Supabase, Railway.
#
# Neon example (use the POOLED connection string for Vercel):
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=

# ── Admin portal ────────────────────────────────────────────────────────────
# Password for the admin gate (/admin). CHANGE THIS before going live!
ADMIN_PASSWORD=change-me

# Random string used to sign the admin session cookie (min 32 chars).
# Must stay the same across deployments, or every admin gets logged out.
# Generate one: openssl rand -hex 32
ADMIN_SECRET=
