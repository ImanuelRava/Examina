# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required in production).
# Free options: Neon (recommended for Vercel), Supabase, Railway.
#
# Neon example (use the POOLED connection string for Vercel):
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=

# ── Admin portal ────────────────────────────────────────────────────────────
# Password for the admin gate (/admin).
# REQUIRED IN PRODUCTION. The app refuses to boot if missing or shorter than 8 chars.
# Use a strong, unique password.
ADMIN_PASSWORD=change-me

# Random string used to sign the admin session cookie.
# REQUIRED IN PRODUCTION. Must be at least 32 characters.
# Must stay the same across deployments, or every admin gets logged out.
# Generate one:  openssl rand -hex 32
ADMIN_SECRET=
